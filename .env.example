# Copy this file to .env and fill in your Supabase project credentials.
# Without these, SabrConnect runs on its built-in local mock backend —
# fully functional for demos, with data stored in the browser's localStorage.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Gemini (AI Recommendations & AI Judging)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY is NOT read from this .env file and must NEVER be added
# here, to a VITE_* variable, or to any client-side/frontend code — that
# would ship it to the browser bundle where anyone can read it.
#
# It is set ONLY as a Supabase Edge Function secret, after deploying
# supabase/functions/gemini-recommend and supabase/functions/gemini-judge:
#
#   supabase functions deploy gemini-recommend
#   supabase functions deploy gemini-judge
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
#   supabase secrets set GEMINI_MODEL=gemini-2.5-flash   # optional, this is the default
#
# Without this secret, AI Recommendations and AI Judging still work — they
# just use the local scoring engine (src/lib/aiMatch.js) instead of a live
# Gemini call.
